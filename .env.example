# ============================================================
# WZORZEC zmiennych srodowiskowych - skopiuj do .env i wypelnij.
# NIGDY nie commituj prawdziwego pliku .env do git (jest w .gitignore).
# ============================================================

# --- Django ---
# Wygeneruj wlasny, dlugi losowy klucz, np.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=wygeneruj-wlasny-dlugi-losowy-klucz-tutaj

# True lokalnie (dev), False na produkcji (Render) - NIGDY True na produkcji!
DEBUG=True

# --- Baza danych (PostgreSQL - lokalnie lub Neon/Render) ---
DB_NAME=dogfitness_db
DB_USER=postgres
DB_PASSWORD=twoje-haslo
DB_HOST=localhost
DB_PORT=5432

# --- Dozwolone domeny (produkcja) ---
# Lokalnie mozesz to pominac (domyslnie localhost,127.0.0.1).
# Na Render dodaj swoja domene, np.:
#   ALLOWED_HOSTS=dogfitness.onrender.com,twoja-domena-wlasna.pl
# (RENDER_EXTERNAL_HOSTNAME jest dodawane AUTOMATYCZNIE przez Render -
#  nie musisz jej recznie ustawiac w zmiennych srodowiskowych).
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF_TRUSTED_ORIGINS - wymagane na produkcji, z protokolem https://
#   CSRF_TRUSTED_ORIGINS=https://dogfitness.onrender.com
CSRF_TRUSTED_ORIGINS=

# --- Cloudinary (opcjonalny storage zdjec w chmurze - domyslnie wylaczony) ---
USE_CLOUDINARY=False
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
